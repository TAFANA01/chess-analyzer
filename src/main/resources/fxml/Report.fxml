<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chessanalyzer.controller.ReportController"
            styleClass="screen-root">

    <top>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="report-toolbar">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <Button text="Review Board" onAction="#onReviewBoard" styleClass="primary-button"/>
            <Button text="New Analysis" onAction="#onNewAnalysis"/>
            <Button text="Export TXT" onAction="#onExportTxt"/>
            <Button text="Export JSON" onAction="#onExportJson"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="contentBox" spacing="6">
                <padding>
                    <Insets top="20" right="40" bottom="40" left="40"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
