<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chessanalyzer.controller.MainController"
      spacing="16" styleClass="screen-root">
    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>

    <Label text="CHESS GAME ANALYZER" styleClass="app-title"/>
    <Label text="Analyze your chess game using Stockfish" styleClass="app-subtitle"/>

    <VBox spacing="8" styleClass="card">
        <Label text="Paste PGN" styleClass="section-label"/>
        <TextArea fx:id="pgnTextArea" promptText="Paste a complete PGN here, e.g.&#10;[Event &quot;Rapid Game&quot;]&#10;[White &quot;Player A&quot;]&#10;[Black &quot;Player B&quot;]&#10;[Result &quot;1-0&quot;]&#10;&#10;1. e4 e5 2. Nf3 Nc6 3. Bb5 a6 ..."
                  wrapText="true" prefRowCount="12"/>
        <HBox spacing="10">
            <Button text="Import PGN File..." onAction="#onImportPgn"/>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>
    </VBox>

    <VBox spacing="8" styleClass="card">
        <Label text="Stockfish Engine" styleClass="section-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="stockfishPathField" promptText="Path to Stockfish executable" HBox.hgrow="ALWAYS"/>
            <Button text="Browse..." onAction="#onBrowseStockfish"/>
        </HBox>
    </VBox>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label text="Analysis:" styleClass="section-label"/>
        <ComboBox fx:id="modeComboBox"/>
    </HBox>

    <Button fx:id="analyzeButton" text="ANALYZE GAME" onAction="#onAnalyzeGame" styleClass="primary-button"/>
</VBox>
