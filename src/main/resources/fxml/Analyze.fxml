<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chessanalyzer.controller.AnalyzeController"
      spacing="18" alignment="CENTER" styleClass="screen-root">
    <padding>
        <Insets top="40" right="48" bottom="40" left="48"/>
    </padding>

    <Label text="Analyzing Game..." styleClass="app-title"/>
    <Label fx:id="gameInfoLabel" styleClass="app-subtitle"/>

    <ProgressBar fx:id="progressBar" prefWidth="420" progress="0"/>

    <HBox spacing="24" alignment="CENTER">
        <VBox alignment="CENTER">
            <Label text="Move" styleClass="section-label"/>
            <Label fx:id="moveCountLabel" text="0 / 0"/>
        </VBox>
        <VBox alignment="CENTER">
            <Label text="Current move" styleClass="section-label"/>
            <Label fx:id="currentMoveLabel" text="-"/>
        </VBox>
        <VBox alignment="CENTER">
            <Label text="Engine depth" styleClass="section-label"/>
            <Label fx:id="depthLabel" text="-"/>
        </VBox>
    </HBox>

    <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"/>
</VBox>
